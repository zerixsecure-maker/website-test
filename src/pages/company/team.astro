---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { company } from '../../data/site';
// Replace role placeholders with real names, photos and bios when ready.
const team = [
  { role: 'Founder & Director', focus: ['Strategy', 'Client leadership'] },
  { role: 'Head, GRC & Compliance', focus: ['ISO 27001', 'DPDP', 'Regulatory'] },
  { role: 'Head, Offensive Security', focus: ['VAPT', 'Red team'] },
  { role: 'Lead Auditor', focus: ['IT audit', 'System audit'] },
  { role: 'Privacy Lead', focus: ['DPDP Act', 'vDPO'] },
  { role: 'SOC & Managed Services Lead', focus: ['Z Sites', 'EDR / XDR'] },
  { role: 'Secure Engineering Lead', focus: ['Code review', 'DevSecOps'] },
  { role: 'Trainer & Awareness Lead', focus: ['Workshops', 'Labs'] },
];
---
<Base title="Our Team | Zerix Securities" description="Meet the people behind Zerix Securities." path="/company/team/" noindex={true}>
  <Header current="company" />
  <main id="main" class="co">
    <section class="co-h"><div class="wrap">
      <div class="kicker">Company · Our team</div>
      <h1>The people behind <span>Zerix.</span></h1>
      <p class="co-lead">Auditors, testers, engineers and trainers, working as one team. Profiles are being added.</p>
    </div></section>
    <section class="co-sec"><div class="wrap team">
      {team.map((m, i) => (
        <article class="tm reveal" style={`--d:${(i % 4) * .07}s;--h:${(i * 37) % 360}`}>
          <div class="tm-av"><svg viewBox="0 0 100 100" aria-hidden="true"><circle cx="50" cy="38" r="17"/><path d="M16 96c2-22 16-34 34-34s32 12 34 34z"/></svg></div>
          <h3>{m.role}</h3>
          <ul>{m.focus.map((f) => <li>{f}</li>)}</ul>
          <small>Profile coming soon</small>
        </article>
      ))}
    </div></section>
    <div class="wrap"><div class="ctab"><div><h2>Want to work with us?</h2><p>Talk to the team that will actually do the work.</p></div><div class="sp-btns"><a class="btn btn-primary" href="/contact/">Get in touch <span class="arr">→</span></a><a class="btn btn-ghost" href="/company/qualifications/">Our qualifications</a></div></div></div>
  </main>
  <Footer />
</Base>
