---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { company } from '../../data/site';
const quals = [
  { a: 'CISA', n: 'Certified Information Systems Auditor', b: 'ISACA', d: 'audit' },
  { a: 'CISM', n: 'Certified Information Security Manager', b: 'ISACA', d: 'gov' },
  { a: 'CISSP', n: 'Certified Information Systems Security Professional', b: '(ISC)²', d: 'gov' },
  { a: 'OSCP', n: 'Offensive Security Certified Professional', b: 'OffSec', d: 'off' },
  { a: 'OSCP+', n: 'Offensive Security Certified Professional Plus', b: 'OffSec', d: 'off' },
  { a: 'CEH', n: 'Certified Ethical Hacker', b: 'EC-Council', d: 'off' },
  { a: 'ISO 27001 LA', n: 'ISO/IEC 27001 Lead Auditor', b: 'ISO standards', d: 'audit' },
  { a: 'ISO 27001 LI', n: 'ISO/IEC 27001 Lead Implementer', b: 'ISO standards', d: 'gov' },
  { a: 'DPO', n: 'Certified Data Protection Officer', b: 'Privacy', d: 'priv' },
  { a: 'IAAP', n: 'Accessibility professional certification', b: 'IAAP', d: 'priv' },
];
const tabs = [['all', 'All'], ['audit', 'Audit'], ['gov', 'Governance'], ['off', 'Offensive security'], ['priv', 'Privacy & accessibility']];
const means = [['Audits you can trust', 'Qualified auditors for IT, system and regulatory audits.'], ['Attack skills that are real', 'Hands-on testers, proven in practical exams.'], ['Leadership that guides', 'Security managers who speak to boards.'], ['Privacy and access for all', 'DPO and accessibility expertise in-house.']];
---
<Base title="Qualifications | Zerix Securities" description="Our team holds CISA, CISM, CISSP, OSCP, CEH, ISO 27001 Lead Auditor and Implementer, DPO and IAAP certifications." path="/company/qualifications/">
  <Header current="company" />
  <main id="main" class="co">
    <section class="co-h"><div class="wrap">
      <div class="kicker">Company · Qualifications</div>
      <h1>Expertise you can <span>verify.</span></h1>
      <p class="co-lead">Our people hold the certifications that matter in audit, governance, offensive security, privacy and accessibility.</p>
    </div></section>
    <section class="co-sec"><div class="wrap">
      <div class="qtabs" role="tablist">{tabs.map((t, i) => <button type="button" class={i === 0 ? 'on' : ''} data-f={t[0]}>{t[1]}</button>)}</div>
      <div class="qgrid">
        {quals.map((q, i) => (
          <article class="qc reveal" data-d={q.d} style={`--d:${(i % 5) * .05}s`}>
            <div class="qb"><i></i><b>{q.a}</b></div>
            <h3>{q.n}</h3><small>{q.b}</small>
          </article>
        ))}
        <article class="qc qmore" data-d="all"><div class="qb"><i></i><b>+</b></div><h3>And more</h3><small>Ask us about specific credentials.</small></article>
      </div>
    </div></section>
    <section class="co-sec"><div class="wrap">
      <div class="means">{means.map((m, i) => <article class="reveal" style={`--d:${i * .07}s`}><b>{String(i + 1).padStart(2, '0')}</b><h3>{m[0]}</h3><p>{m[1]}</p></article>)}</div>
    </div></section>
    <div class="wrap"><div class="ctab"><div><h2>Need a qualified team on your project?</h2><p>Tell us what you are working on.</p></div><div class="sp-btns"><a class="btn btn-primary" href={`mailto:${company.email}`}>Talk to an expert <span class="arr">→</span></a><a class="btn btn-ghost" href="/services/">Our services</a></div></div></div>
  </main>
  <Footer />
  <script>
    const tabs = [...document.querySelectorAll<HTMLElement>('.qtabs button')], cards = [...document.querySelectorAll<HTMLElement>('.qc')];
    tabs.forEach((t) => t.addEventListener('click', () => { tabs.forEach((x) => x.classList.toggle('on', x === t)); const f = t.dataset.f; cards.forEach((c) => c.classList.toggle('hide', f !== 'all' && c.dataset.d !== f && c.dataset.d !== 'all')); }));
  </script>
</Base>
