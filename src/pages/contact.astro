---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Presence from '../components/Presence.astro';
import { company, offices, formEndpoint } from '../data/site';
import { services, allPages } from '../data/services';
const topics = [...services.map((s) => s.name), 'Products', 'Training & awareness', 'Something else'];
const map: Record<string, string> = {};
allPages.forEach((p) => { map[p.name] = p.parent?.name ?? p.name; });
const mapsUrl = 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(company.hq);
const detail: Record<string, string> = { Mumbai: company.hq, Kolkata: 'Reach us at the email or phone listed here.', 'New York': 'Reach us at the email or phone listed here.' };
---
<Base title="Contact Zerix Securities | Talk to a cybersecurity expert" description="Contact Zerix Securities in Mumbai. Tell us what you need, audit, certification, VAPT or managed security, and we will get back to you." path="/contact/">
  <Header current="contact" />
  <main id="main" class="co ct">
    <section class="co-h"><div class="wrap">
      <div class="kicker">Contact</div>
      <h1>Let's talk <span>security.</span></h1>
      <p class="co-lead">Tell us what you are working on. A short call is enough to scope it. No pressure, no jargon.</p>
    </div></section>

    <section class="co-sec"><div class="wrap ct-grid">
      <form class="ct-form reveal" id="cform" novalidate data-endpoint={formEndpoint} data-to={company.email} data-map={JSON.stringify(map)}>
        <div class="ct-row">
          <label><span>Your name</span><input name="name" autocomplete="name" required placeholder="Full name" /></label>
          <label><span>Work email</span><input name="email" type="email" autocomplete="email" required placeholder="you@company.com" /></label>
        </div>
        <div class="ct-row">
          <label><span>Phone <i>optional</i></span><input name="phone" type="tel" autocomplete="tel" placeholder="+91" /></label>
          <label><span>Organisation</span><input name="org" autocomplete="organization" placeholder="Company name" /></label>
        </div>
        <label><span>I am interested in</span>
          <select name="topic">{topics.map((t) => <option value={t}>{t}</option>)}</select>
        </label>
        <label><span>How can we help?</span><textarea name="message" rows="5" required placeholder="A line or two is enough."></textarea></label>
        <input class="hp" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <p class="ct-err" id="cerr" role="alert" hidden>Please fill in your name, a valid email and a short message.</p>
        <div class="ct-act">
          <button class="btn btn-primary" type="submit">Send message <span class="arr">→</span></button>
          <small>We use your details only to reply to you.</small>
        </div>
        <div class="ct-ok" id="cok" hidden><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M7 12.500l3.500 3.500L17 9"/></svg><div><b>Thank you.</b><p id="cokmsg">We will get back to you shortly.</p></div></div>
      </form>

      <aside class="ct-side reveal" style="--d:.1s">
        <h2>Reach us directly</h2>
        <a class="ct-l" href={`mailto:${company.email}`}><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg><span><small>Email</small>{company.email}</span></a>
        <a class="ct-l" href={`tel:${company.phoneHref}`}><svg viewBox="0 0 24 24"><path d="M5 4h4l2 5-2.500 1.500a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/></svg><span><small>Phone</small>{company.phone}</span></a>
        <a class="ct-l" href={mapsUrl} target="_blank" rel="noopener"><svg viewBox="0 0 24 24"><path d="M12 21s7-6.100 7-11a7 7 0 0 0-14 0c0 4.900 7 11 7 11z"/><circle cx="12" cy="10" r="2.500"/></svg><span><small>Headquarters</small>{company.hq}</span></a>
        <div class="ct-off">
          <small class="ct-k">Our offices</small>
          {offices.map((o) => (
            <div class={`ct-o${o.hq ? ' hq' : ''}`}><i></i><div><b>{o.name}</b><em>{o.tag}</em></div></div>
          ))}
        </div>
      </aside>
    </div></section>

    <Presence head={false} cards={false} />
  </main>
  <Footer />
  <script>
    const f = document.getElementById('cform') as HTMLFormElement;
    const q = new URLSearchParams(location.search).get('topic');
    if (q) {
      const m = JSON.parse(f.dataset.map || '{}'); const sel = f.elements.namedItem('topic') as HTMLSelectElement;
      const want = m[q] || q; if ([...sel.options].some((o) => o.value === want)) sel.value = want;
    }
    f.addEventListener('submit', async (e) => {
      e.preventDefault();
      const d = Object.fromEntries(new FormData(f)) as Record<string, string>;
      const err = document.getElementById('cerr')!, ok = document.getElementById('cok')!, msg = document.getElementById('cokmsg')!;
      if (d.website) return;
      if (!d.name.trim() || !/^\S+@\S+\.\S+$/.test(d.email) || !d.message.trim()) { err.hidden = false; return; }
      err.hidden = true;
      const body = `Name: ${d.name}\nEmail: ${d.email}\nPhone: ${d.phone || '-'}\nOrganisation: ${d.org || '-'}\nInterested in: ${d.topic}\n\n${d.message}`;
      const ep = f.dataset.endpoint;
      try {
        if (ep) {
          // Google Apps Script endpoints do not return CORS headers, so send a simple request and treat it as sent.
          await fetch(ep, { method: 'POST', mode: 'no-cors', body: new URLSearchParams(d) });
          msg.textContent = 'Your message has been sent. We will get back to you shortly.';
        } else {
          location.href = `mailto:${f.dataset.to}?subject=${encodeURIComponent('Enquiry: ' + d.topic)}&body=${encodeURIComponent(body)}`;
          msg.textContent = 'Your email app should open with the message ready to send. If it does not, write to us directly at the address on this page.';
        }
        ok.hidden = false; f.querySelectorAll('input,select,textarea,button').forEach((x) => ((x as HTMLInputElement).disabled = true));
      } catch { err.textContent = 'Sorry, that did not send. Please email us directly.'; err.hidden = false; }
    });
  </script>
</Base>
