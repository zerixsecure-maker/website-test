---
import Base from '../layouts/Base.astro';
---
<Base>
  <header class="site-header">
    <div class="wrap nav">
      <a href="/" class="brand"><img src="/logo.png" alt="Zerix Securities logo" />Zerix</a>
      <ul>
        <li><a href="#services">What we do</a></li>
        <li><a href="#how">How it works</a></li>
        <li><a href="#who">Who we serve</a></li>
      </ul>
      <a href="#contact" class="btn btn-primary">Talk to an expert</a>
    </div>
  </header>

  <main>
    <!-- HERO -->
    <section class="hero" style="padding-top:56px">
      <div class="wrap hero-grid">
        <div>
          <div class="eyebrow">Cybersecurity · Compliance · Assurance</div>
          <h1>We find your security gaps, <em>fix them,</em> and prove it.</h1>
          <p class="lead">Zerix Securities helps banks, brokers, enterprises and critical-infrastructure operators stay secure and audit-ready — from first assessment to regulator-ready evidence.</p>
          <div class="cta-row">
            <a href="#services" class="btn btn-primary">See what we do →</a>
            <a href="#contact" class="btn btn-ghost">Talk to an expert</a>
          </div>
          <div class="proof">
            <span>Security audits</span>
            <span>Regulatory compliance</span>
            <span>Training &amp; certification</span>
          </div>
        </div>

        <svg class="hero-art" viewBox="0 0 560 430" role="img" aria-label="A shield protecting connected systems">
          <defs>
            <linearGradient id="sg" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="#c995e6" /><stop offset="1" stop-color="#5b2d8c" />
            </linearGradient>
            <path id="p1" d="M20 90 H150 L200 170 H340" />
            <path id="p2" d="M20 215 H340" />
            <path id="p3" d="M20 340 H150 L200 260 H340" />
          </defs>

          <g class="spin"><circle class="ring dash" cx="400" cy="215" r="165" /></g>
          <g class="spin rev"><circle class="ring" cx="400" cy="215" r="125" /></g>
          <circle class="pulse" cx="400" cy="215" r="90" />
          <circle class="pulse d2" cx="400" cy="215" r="90" />

          <path class="trace" d="M20 90 H150 L200 170 H340" />
          <path class="trace t2" d="M20 215 H340" />
          <path class="trace t3" d="M20 340 H150 L200 260 H340" />
          <circle class="node" cx="20" cy="90" r="7" />
          <circle class="node" cx="20" cy="215" r="7" />
          <circle class="node" cx="20" cy="340" r="7" />

          <circle class="packet" r="4.5"><animateMotion dur="3.6s" repeatCount="indefinite" begin="2s"><mpath href="#p1" /></animateMotion></circle>
          <circle class="packet" r="4.5"><animateMotion dur="3s" repeatCount="indefinite" begin="2.4s"><mpath href="#p2" /></animateMotion></circle>
          <circle class="packet" r="4.5"><animateMotion dur="3.8s" repeatCount="indefinite" begin="2.8s"><mpath href="#p3" /></animateMotion></circle>

          <g class="shield">
            <path d="M400 135 L462 158 V215 C462 262 434 292 400 308 C366 292 338 262 338 215 V158 Z" />
            <circle cx="400" cy="205" r="14" fill="#fff" />
            <path d="M394 212 H406 L408 236 H392 Z" fill="#fff" />
            <circle cx="400" cy="205" r="5" fill="#7a3fb0" />
          </g>

          <g class="tag"><rect x="468" y="60" width="78" height="28" rx="14" /><text x="507" y="79" text-anchor="middle">ISO 27001</text></g>
          <g class="tag b"><rect x="480" y="300" width="64" height="28" rx="14" /><text x="512" y="319" text-anchor="middle">SOC 2</text></g>
          <g class="tag c"><rect x="262" y="378" width="64" height="28" rx="14" /><text x="294" y="397" text-anchor="middle">DPDP</text></g>
          <g class="tag d"><rect x="250" y="22" width="68" height="28" rx="14" /><text x="284" y="41" text-anchor="middle">CSCRF</text></g>
        </svg>
      </div>
    </section>

    <!-- WHAT WE DO -->
    <section id="services">
      <div class="wrap">
        <div class="section-head reveal">
          <h2>What we do</h2>
          <p>Four things, done end to end — so security stops being a pile of separate vendors and reports.</p>
        </div>
        <div class="cards">
          <article class="card reveal" style="--d:0s">
            <div class="ico"><svg viewBox="0 0 24 24"><path d="M12 3l8 3v6c0 4.5-3.2 7.8-8 9-4.8-1.2-8-4.5-8-9V6z"/><path d="M9 12l2 2 4-4"/></svg></div>
            <h3>Compliance &amp; Governance</h3>
            <p>Build the policies, controls and evidence regulators expect, and keep them current.</p>
            <ul><li>CSCRF</li><li>DPDP</li><li>ISO 27001</li><li>SOC 2</li></ul>
          </article>
          <article class="card reveal" style="--d:.08s">
            <div class="ico"><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/><path d="M8 11h6M11 8v6"/></svg></div>
            <h3>Audit &amp; Assurance</h3>
            <p>Independent assessments that show where you stand and what to fix first.</p>
            <ul><li>Gap assessment</li><li>Audit readiness</li></ul>
          </article>
          <article class="card reveal" style="--d:.16s">
            <div class="ico"><svg viewBox="0 0 24 24"><path d="M4 19V9M10 19V5M16 19v-7M22 19H2"/></svg></div>
            <h3>Risk &amp; Advisory</h3>
            <p>Practical, prioritised guidance and remediation support from experienced consultants.</p>
            <ul><li>Risk assessment</li><li>Remediation</li></ul>
          </article>
          <article class="card reveal" style="--d:.24s">
            <div class="ico"><svg viewBox="0 0 24 24"><path d="M2 9l10-5 10 5-10 5z"/><path d="M6 11.5V16c0 1.5 2.7 3 6 3s6-1.5 6-3v-4.5"/></svg></div>
            <h3>Training &amp; Awareness</h3>
            <p>Workshops and seminars that turn your people into your first line of defence.</p>
            <ul><li>Workshops</li><li>Seminars</li></ul>
          </article>
        </div>
      </div>
    </section>

    <!-- HOW -->
    <section id="how" class="flow-bg">
      <div class="wrap">
        <div class="section-head reveal">
          <h2>How an engagement works</h2>
          <p>A clear path from "where are we exposed?" to "here is the proof."</p>
        </div>
        <div class="flow">
          <div class="step reveal" style="--d:0s"><div class="num">1</div><h3>Discover</h3><p>We map your systems, data and the regulations that apply to you.</p></div>
          <div class="step reveal" style="--d:.1s"><div class="num">2</div><h3>Assess</h3><p>We test controls and rank every gap by real business risk.</p></div>
          <div class="step reveal" style="--d:.2s"><div class="num">3</div><h3>Remediate</h3><p>We help your team close the gaps, with owners and timelines.</p></div>
          <div class="step reveal" style="--d:.3s"><div class="num">4</div><h3>Assure</h3><p>We prepare the evidence and support you through the audit.</p></div>
        </div>
      </div>
    </section>

    <!-- WHO -->
    <section id="who">
      <div class="wrap who">
        <div class="reveal">
          <h2 style="font-size:clamp(1.9rem,3.4vw,2.7rem)">Built for regulated, high-stakes environments</h2>
          <div class="regions"><span><b>India</b></span><span><b>UAE</b></span><span><b>Singapore</b></span></div>
        </div>
        <div class="chips reveal" style="--d:.1s">
          <div class="chip">Banking &amp; Financial Services</div>
          <div class="chip">Capital Markets</div>
          <div class="chip">Enterprises</div>
          <div class="chip">Critical Infrastructure</div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section id="contact" class="cta" style="padding-top:0">
      <div class="cta-box reveal">
        <h2>Not sure where your security stands? Let's find out.</h2>
        <a href="mailto:contact@example.com" class="btn">Talk to an expert →</a>
      </div>
    </section>
  </main>

  <footer>
    <div class="wrap foot">
      <span><strong>Zerix Securities</strong> — Think Cyber, Think Zerix</span>
      <span>© {new Date().getFullYear()} Zerix Securities. All rights reserved.</span>
    </div>
  </footer>
</Base>
