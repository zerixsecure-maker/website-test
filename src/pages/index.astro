---
import Base from '../layouts/Base.astro';
import NetworkBg from '../components/NetworkBg.astro';
---
<Base>
  <header class="site-header">
    <div class="wrap nav">
      <a href="/" class="brand" aria-label="Zerix Securities home">
        <img src="/logo.png" alt="" />
        <span class="word"><b>ZERIX</b><small>Securities</small></span>
      </a>
      <ul>
        <li><a href="#services">What we do</a></li>
        <li><a href="#how">How it works</a></li>
        <li><a href="#who">Who we serve</a></li>
      </ul>
      <a href="#contact" class="btn btn-primary">Contact us <span class="arr">→</span></a>
    </div>
  </header>

  <main>
    <!-- HERO -->
    <section class="hero" style="padding-top:40px">
      <div class="blob b1"></div>
      <div class="blob b2"></div>
      <NetworkBg />

      <div class="wrap hero-grid">
        <div>
          <div class="eyebrow"><span class="dot"></span>Cybersecurity · Compliance · Assurance</div>
          <h1>
            <span>Find the gaps.</span>
            <span>Fix them.</span>
            <span class="grad">Prove it.</span>
          </h1>
          <p class="lead">Zerix Securities helps banks, brokers, enterprises and critical-infrastructure operators stay secure and audit-ready — from first assessment to regulator-ready evidence.</p>
          <div class="cta-row">
            <a href="#services" class="btn btn-primary">What we do <span class="arr">→</span></a>
            <a href="#contact" class="btn btn-ghost">Talk to an expert</a>
          </div>
        </div>

        <div class="stage" aria-hidden="true">
          <svg class="rings" viewBox="0 0 560 560">
            <g class="sp slow"><circle class="r-tick" cx="280" cy="280" r="262" /></g>
            <circle class="r-thin" cx="280" cy="280" r="232" />
            <g class="sp rev">
              <circle class="r-dash" cx="280" cy="280" r="205" />
              <circle class="orb f" cx="485" cy="280" r="6" />
              <circle class="orb" cx="177" cy="458" r="6" />
            </g>
            <g class="sp">
              <circle class="orb f" cx="512" cy="280" r="5" />
              <circle class="orb" cx="164" cy="481" r="5" />
              <circle class="orb f" cx="164" cy="79" r="5" />
            </g>
          </svg>
          <div class="sweep"></div>
          <i class="corner tl"></i><i class="corner tr"></i><i class="corner bl"></i><i class="corner br"></i>
          <div class="core"><img src="/logo.png" alt="" /></div>
          <span class="lab t">ASSESS</span>
          <span class="lab r">COMPLY</span>
          <span class="lab b">DEFEND</span>
          <span class="lab l">ASSURE</span>
        </div>
      </div>
    </section>

    <div class="strip">
      <div class="wrap">
        <span class="cap">Frameworks we work with</span>
        <ul><li>CSCRF</li><li>DPDP Act</li><li>ISO 27001</li><li>SOC 2</li></ul>
      </div>
    </div>

    <!-- WHAT WE DO -->
    <section id="services">
      <div class="wrap">
        <div class="section-head reveal">
          <div class="kicker">Capabilities</div>
          <h2>Security, compliance and assurance — under one roof.</h2>
          <p>Four disciplines, delivered end to end by one team.</p>
        </div>
        <div class="cards">
          <article class="card reveal">
            <span class="no">01</span>
            <svg viewBox="0 0 24 24"><path d="M12 3l8 3v6c0 4.5-3.2 7.8-8 9-4.8-1.2-8-4.5-8-9V6z"/><path d="M9 12l2 2 4-4"/></svg>
            <h3>Compliance &amp; Governance</h3>
            <p>Policies, controls and evidence aligned to the regulations that apply to you.</p>
          </article>
          <article class="card reveal" style="--d:.08s">
            <span class="no">02</span>
            <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
            <h3>Audit &amp; Assurance</h3>
            <p>Independent assessments that show where you stand and what to fix first.</p>
          </article>
          <article class="card reveal" style="--d:.16s">
            <span class="no">03</span>
            <svg viewBox="0 0 24 24"><path d="M4 19V9M10 19V5M16 19v-7M22 19H2"/></svg>
            <h3>Risk &amp; Advisory</h3>
            <p>Prioritised guidance and remediation support from experienced consultants.</p>
          </article>
          <article class="card reveal" style="--d:.24s">
            <span class="no">04</span>
            <svg viewBox="0 0 24 24"><path d="M2 9l10-5 10 5-10 5z"/><path d="M6 11.5V16c0 1.5 2.7 3 6 3s6-1.5 6-3v-4.5"/></svg>
            <h3>Training &amp; Awareness</h3>
            <p>Workshops and seminars that make your people the first line of defence.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- HOW -->
    <section id="how" class="flow-bg">
      <div class="wrap">
        <div class="section-head reveal">
          <div class="kicker">Approach</div>
          <h2>A clear path from exposure to evidence.</h2>
        </div>
        <div class="flow">
          <div class="step reveal"><span class="no">01</span><h3>Discover</h3><p>Map systems, data and the regulations that apply.</p></div>
          <div class="step reveal" style="--d:.1s"><span class="no">02</span><h3>Assess</h3><p>Test controls and rank every gap by business risk.</p></div>
          <div class="step reveal" style="--d:.2s"><span class="no">03</span><h3>Remediate</h3><p>Close the gaps with clear owners and timelines.</p></div>
          <div class="step reveal" style="--d:.3s"><span class="no">04</span><h3>Assure</h3><p>Prepare the evidence and support you through audit.</p></div>
        </div>
      </div>
    </section>

    <!-- WHO -->
    <section id="who">
      <div class="wrap who">
        <div class="reveal">
          <div class="kicker">Sectors</div>
          <h2>Built for regulated, high-stakes environments.</h2>
          <div class="regions"><span>India</span><span>UAE</span><span>Singapore</span></div>
        </div>
        <div class="rows reveal" style="--d:.1s">
          <div class="row">Banking &amp; Financial Services <span>→</span></div>
          <div class="row">Capital Markets <span>→</span></div>
          <div class="row">Enterprises <span>→</span></div>
          <div class="row">Critical Infrastructure <span>→</span></div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section id="contact" class="cta">
      <div class="wrap">
        <div class="cta-box reveal">
          <h2>Not sure where your security stands? Let's find out.</h2>
          <a href="mailto:contact@example.com" class="btn">Talk to an expert <span class="arr">→</span></a>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div class="wrap foot">
      <span><strong>ZERIX SECURITIES</strong> — Think Cyber, Think Zerix</span>
      <span>© {new Date().getFullYear()} Zerix Securities. All rights reserved.</span>
    </div>
  </footer>
</Base>
