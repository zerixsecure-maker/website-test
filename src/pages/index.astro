---
import Base from '../layouts/Base.astro';
import NetworkBg from '../components/NetworkBg.astro';

// NOTE: client "logos" are placeholder wordmarks. Replace with real logo files in /public/clients/.
const clientsA = ['Jainam Electronics', 'Mahavir Tube', 'Yash Optics', 'Trover Solutions', 'IEMA Labs'];
const clientsB = ['Gili Tech', 'Vernife', 'Abilini', 'Facet Flare', 'Arch', 'O-Locker'];
const mono = (n: string) => n.replace(/[^A-Za-z ]/g, '').split(' ').map((w) => w[0]).join('').slice(0, 2).toUpperCase();

const services = [
  { t: 'Cybersecurity Audits & Assurance', d: 'Independent assessments of your security posture, with evidence you can stand behind.',
    i: '<path d="M12 3l8 3v6c0 4.5-3.2 7.8-8 9-4.8-1.2-8-4.5-8-9V6z"/><path class="acc" d="M9 12l2 2 4-4"/>' },
  { t: 'Regulatory Cybersecurity Audits', d: 'Audits mapped to cybersecurity mandates such as CSCRF, so you are ready when regulators ask.',
    i: '<path d="M6 3h9l4 4v14H6z"/><path d="M14 3v5h5"/><path class="acc" d="M9 13h7M9 17h5"/>' },
  { t: 'VAPT', d: 'Vulnerability assessment and penetration testing that finds what attackers would find first.',
    i: '<circle cx="12" cy="12" r="8"/><path d="M12 2v4M12 18v4M2 12h4M18 12h4"/><circle class="acc" cx="12" cy="12" r="3"/>' },
  { t: 'Infrastructure Security', d: 'Hardening and review of networks, servers, cloud and endpoints.',
    i: '<rect x="3" y="4" width="18" height="6" rx="1.5"/><rect x="3" y="14" width="18" height="6" rx="1.5"/><path class="acc" d="M7 7h.01M7 17h.01"/>' },
  { t: 'OT Security', d: 'Protection for industrial and operational technology where downtime is not an option.',
    i: '<path d="M3 21V10l6 4v-4l6 4V6h6v15z"/><path class="acc" d="M7 18h2M12 18h2M17 18h2"/>' },
  { t: 'Digital Forensics', d: 'Evidence-grade investigation of incidents, from acquisition through to analysis and reporting.',
    i: '<circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.5 15.5L21 21"/><path class="acc" d="M7.5 10.5a3 3 0 0 1 6 0"/>' },
  { t: 'Malware Analysis', d: 'Understand what a sample does, how it got in, and how to contain it.',
    i: '<path d="M9 8a3 3 0 0 1 6 0v7a3 3 0 0 1-6 0z"/><path d="M12 8v10"/><path class="acc" d="M5 9l4 2M19 9l-4 2M5 15l4-2M19 15l-4-2"/>' },
  { t: 'Corporate & Private Investigations', d: 'Discreet, forensically sound investigations for organisations and individuals.',
    i: '<path d="M2 12s4-7 10-7 10 7 10 7-4 7-10 7S2 12 2 12z"/><circle class="acc" cx="12" cy="12" r="3"/>' },
  { t: 'Corporate Training', d: 'Hands-on programmes that build security skills across your teams.',
    i: '<path d="M2 9l10-5 10 5-10 5z"/><path d="M6 11.5V16c0 1.5 2.7 3 6 3s6-1.5 6-3v-4.5"/><path class="acc" d="M22 9v6"/>' },
];

const steps = [
  { t: 'Trace the root', d: 'We start where forensics starts: understanding how your environment really works and where risk truly originates.' },
  { t: 'Collect the evidence', d: 'Logs, configurations, access and data flows are examined as evidence — not assumptions.' },
  { t: 'Reconstruct and assess', d: 'We rebuild the full picture and rank every gap by real business impact.' },
  { t: 'Remediate at the source', d: 'Root causes get fixed, not symptoms — with clear owners and timelines.' },
  { t: 'Prove it', d: 'Evidence-backed reports that stand up to auditors, regulators and boards.' },
];
const layers = ['ROOT', 'EVIDENCE', 'RECONSTRUCT', 'REMEDIATE', 'ASSURE'];
---
<Base>
  <header class="site-header">
    <div class="wrap nav">
      <a href="/" class="brand" aria-label="Zerix Securities home">
        <img src="/logo.png" alt="" />
        <span class="word"><b>ZERIX</b><small>Securities</small></span>
      </a>
      <ul>
        <li><a href="#clients">Clients</a></li>
        <li><a href="#services">Services</a></li>
        <li><a href="#approach">Approach</a></li>
      </ul>
      <a href="#contact" class="btn btn-primary">Contact us <span class="arr">→</span></a>
    </div>
  </header>

  <main>
    <!-- HERO -->
    <section class="hero" style="padding-top:40px">
      <div class="blob b1"></div>
      <div class="blob b2"></div>
      <NetworkBg />

      <div class="wrap hero-grid">
        <div>
          <div class="slides" aria-live="polite">
            <div class="slide active">
              <h1 class="h"><span class="ln">Find the gaps.</span><span class="ln">Fix them.</span><span class="ln grad">Prove it.</span></h1>
              <p class="lead">Zerix Securities helps organisations stay secure and audit-ready — from first assessment to regulator-ready evidence.</p>
            </div>
            <div class="slide">
              <h2 class="h"><span class="ln">Think Cyber.</span><span class="ln grad">Think Zerix.</span></h2>
              <p class="lead">A forensic-driven cybersecurity company. We begin by understanding the roots of every risk, so what we fix stays fixed.</p>
            </div>
            <div class="slide">
              <h2 class="h"><span class="ln">Regulator-ready.</span><span class="ln">Audit-proof.</span><span class="ln grad">On time.</span></h2>
              <p class="lead">For banks, brokers and capital-market institutions: cybersecurity audits and compliance aligned to the mandates that apply to you.</p>
            </div>
            <div class="slide">
              <h2 class="h"><span class="ln">Secure the systems</span><span class="ln">that keep</span><span class="ln grad">operations running.</span></h2>
              <p class="lead">Infrastructure and OT security for critical-infrastructure operators and industrial enterprises.</p>
            </div>
            <div class="slide">
              <h2 class="h"><span class="ln">When an incident</span><span class="ln">happens, we find</span><span class="ln grad">the truth.</span></h2>
              <p class="lead">Digital forensics, malware analysis and investigations for enterprises that need answers they can rely on.</p>
            </div>
          </div>
          <div class="cta-row">
            <a href="#services" class="btn btn-primary">Our services <span class="arr">→</span></a>
            <a href="#contact" class="btn btn-ghost">Talk to an expert</a>
          </div>
          <div class="dots" role="tablist" aria-label="Choose message">
            {[0, 1, 2, 3, 4].map((n) => <button type="button" aria-label={`Show message ${n + 1}`}></button>)}
          </div>
        </div>

        <div class="stage" aria-hidden="true">
          <svg class="rings" viewBox="0 0 560 560">
            <g class="sp slow"><circle class="r-tick" cx="280" cy="280" r="262" /></g>
            <circle class="r-thin" cx="280" cy="280" r="232" />
            <g class="sp rev">
              <circle class="r-dash" cx="280" cy="280" r="205" />
              <circle class="orb f" cx="485" cy="280" r="6" />
              <circle class="orb" cx="177" cy="458" r="6" />
            </g>
            <g class="sp">
              <circle class="orb f" cx="512" cy="280" r="5" />
              <circle class="orb" cx="164" cy="481" r="5" />
              <circle class="orb f" cx="164" cy="79" r="5" />
            </g>
          </svg>
          <div class="sweep"></div>
          <i class="corner tl"></i><i class="corner tr"></i><i class="corner bl"></i><i class="corner br"></i>
          <div class="core"><img src="/logo.png" alt="" /></div>
          <span class="lab t">ASSESS</span>
          <span class="lab r">COMPLY</span>
          <span class="lab b">DEFEND</span>
          <span class="lab l">ASSURE</span>
        </div>
      </div>
    </section>

    <!-- CLIENTELE -->
    <section id="clients" class="clients">
      <div class="wrap">
        <div class="section-head reveal">
          <div class="kicker">Clientele</div>
          <h2>Trusted by organisations across industries.</h2>
          <p>From one-off audits to fully managed security, we meet each client where they are.</p>
        </div>
      </div>
      <div class="marq reveal">
        <div class="track">
          {[...clientsA, ...clientsA, ...clientsA, ...clientsA].map((n) => <div class="logo"><i>{mono(n)}</i><span>{n}</span></div>)}
        </div>
      </div>
      <div class="marq rev reveal" style="--d:.1s">
        <div class="track">
          {[...clientsB, ...clientsB, ...clientsB, ...clientsB].map((n) => <div class="logo"><i>{mono(n)}</i><span>{n}</span></div>)}
        </div>
      </div>
    </section>

    <!-- SERVICES -->
    <section id="services">
      <div class="wrap">
        <div class="section-head reveal">
          <div class="kicker">Services</div>
          <h2>Everything from audit to investigation, under one roof.</h2>
          <p>A glimpse of what we deliver. Tell us your situation and we'll point you to the right fit.</p>
        </div>

        <div class="svc reveal">
          {services.map((s, i) => (
            <article class="card">
              <span class="no">{String(i + 1).padStart(2, '0')}</span>
              <svg viewBox="0 0 24 24" aria-hidden="true" set:html={s.i}></svg>
              <h3>{s.t}</h3>
              <p>{s.d}</p>
            </article>
          ))}
        </div>

        <!-- MANAGED SERVICES -->
        <div class="managed reveal">
          <div class="m-copy">
            <div class="kicker light">Managed services</div>
            <h3>We don't just assess. We run security with you.</h3>
            <p>Continuous protection delivered by our own team, tooling and in-house SOC.</p>
            <ul class="chips">
              <li>EDR</li><li>XDR</li><li>MDM</li><li>In-house SOC</li><li>…and more</li>
            </ul>
          </div>
          <div class="m-viz" aria-hidden="true">
            <svg viewBox="0 0 320 320">
              <circle class="rd" cx="160" cy="160" r="140" /><circle class="rd" cx="160" cy="160" r="100" />
              <circle class="rd" cx="160" cy="160" r="60" /><circle class="rd" cx="160" cy="160" r="20" />
              <path class="rd" d="M160 20V300M20 160H300" />
              <circle class="blip" cx="220" cy="98" r="5" /><circle class="blip b2" cx="96" cy="128" r="5" />
              <circle class="blip b3" cx="200" cy="216" r="5" /><circle class="blip b4" cx="128" cy="236" r="4" />
            </svg>
            <div class="rsweep"></div>
          </div>
        </div>

        <!-- GUIDED FINDER TEASER -->
        <div class="finder reveal">
          <div>
            <h3>Not sure which service you need?</h3>
            <p>Soon you'll be able to tell us your sector, your infrastructure and your challenges — and we'll recommend the right services.</p>
          </div>
          <div class="f-flow" aria-hidden="true">
            <span>Your sector</span><i>→</i><span>Your infrastructure</span><i>→</i><span>Your challenges</span><i>→</i><span class="go">Recommended services</span>
          </div>
        </div>
      </div>
    </section>

    <!-- APPROACH -->
    <section id="approach" class="flow-bg">
      <div class="wrap">
        <div class="section-head reveal">
          <div class="kicker">Approach</div>
          <h2>Forensic-driven, from the roots up.</h2>
          <p>Forensics is our foundation. We don't guess where risk lives — we trace it to its source. Think Cyber, Think Zerix.</p>
        </div>

        <div class="approach">
          <ol class="tl" id="tl">
            <span class="fill"></span>
            {steps.map((s, i) => (
              <li class={`tstep${i === 0 ? ' on' : ''}`} data-i={i}>
                <span class="no">{String(i + 1).padStart(2, '0')}</span>
                <h3>{s.t}</h3>
                <p>{s.d}</p>
              </li>
            ))}
          </ol>

          <div class="viz-col">
            <svg class="viz" id="viz" viewBox="0 0 460 540" aria-hidden="true" style="--i:0;--p:.2">
              <path class="root" pathLength="1" d="M230 20 C230 120 150 160 120 260 C90 360 140 430 110 520" />
              <path class="root r2" pathLength="1" d="M230 20 C230 140 300 190 330 290 C355 380 310 450 340 520" />
              <path class="root r3" pathLength="1" d="M230 20 C225 170 235 330 230 520" />
              <line class="spine" x1="36" y1="30" x2="36" y2="500" />
              {layers.map((l, i) => (
                <g class={`layer${i === 0 ? ' on' : ''}`} data-i={i} transform={`translate(0 ${30 + i * 98})`}>
                  <rect class="bx" x="70" y="0" width="320" height="74" rx="12" />
                  <text x="94" y="30" class="lt">{String(i + 1).padStart(2, '0')} · {l}</text>
                  <rect class="bar" x="94" y="44" width="150" height="5" rx="2.5" />
                  <rect class="bar" x="94" y="55" width="96" height="5" rx="2.5" />
                  <rect class="bar" x="258" y="44" width="96" height="5" rx="2.5" />
                  <rect class="bar" x="204" y="55" width="150" height="5" rx="2.5" />
                </g>
              ))}
              <g class="probe"><circle class="pr" cx="36" cy="67" r="16" /><circle cx="36" cy="67" r="7" /></g>
              <g class="lens"><circle cx="372" cy="67" r="34" /><path d="M396 91l22 22" /></g>
            </svg>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section id="contact" class="cta">
      <div class="wrap">
        <div class="cta-box reveal">
          <h2>Not sure where your security stands? Let's find out.</h2>
          <a href="mailto:contact@example.com" class="btn">Talk to an expert <span class="arr">→</span></a>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div class="wrap foot">
      <span><strong>ZERIX SECURITIES</strong> — Think Cyber, Think Zerix</span>
      <span>© {new Date().getFullYear()} Zerix Securities. All rights reserved.</span>
    </div>
  </footer>

  <script>
    // ---- Hero carousel (5s per message) ----
    const slides = [...document.querySelectorAll<HTMLElement>('.slide')];
    const dots = [...document.querySelectorAll<HTMLElement>('.dots button')];
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let cur = 0, timer: number;
    const go = (n: number) => {
      slides[cur].classList.remove('active'); dots[cur].classList.remove('on');
      cur = (n + slides.length) % slides.length;
      slides[cur].classList.add('active');
      const d = dots[cur]; d.classList.remove('on'); void d.offsetWidth; d.classList.add('on');
    };
    const schedule = () => { clearTimeout(timer); if (!reduce) timer = window.setTimeout(() => { go(cur + 1); schedule(); }, 5000); };
    dots.forEach((d, i) => d.addEventListener('click', () => { go(i); schedule(); }));
    dots[0].classList.add('on'); schedule();

    // ---- Approach: scroll-driven timeline + visual ----
    const tsteps = [...document.querySelectorAll<HTMLElement>('.tstep')];
    const layers = [...document.querySelectorAll<SVGGElement>('.layer')];
    const viz = document.getElementById('viz');
    const tl = document.getElementById('tl');
    const setStep = (i: number) => {
      tsteps.forEach((s, k) => s.classList.toggle('on', k <= i && k === i));
      layers.forEach((l, k) => l.classList.toggle('on', k === i));
      viz?.style.setProperty('--i', String(i));
      viz?.style.setProperty('--p', String((i + 1) / tsteps.length));
      tl?.style.setProperty('--prog', String((i + 1) / tsteps.length));
    };
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) setStep(Number((e.target as HTMLElement).dataset.i)); }), { rootMargin: '-42% 0px -48% 0px' });
      tsteps.forEach((s) => io.observe(s));
    }
    setStep(0);
  </script>
</Base>
