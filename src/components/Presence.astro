---
import { company, offices } from '../data/site';
import { worldDots } from '../data/worldDots';
const W = 1000, K = 1000 / 360;
const pt = (lon: number, lat: number) => ({ x: (lon + 180) * K, y: (84 - lat) * K });
const pins = offices.map((o) => ({ ...o, ...pt(o.lon, o.lat) }));
const [mum, kol, nyc] = pins;
const arc = (a: any, b: any, lift: number) => `M${a.x.toFixed(1)} ${a.y.toFixed(1)} Q${((a.x + b.x) / 2).toFixed(1)} ${(Math.min(a.y, b.y) - lift).toFixed(1)} ${b.x.toFixed(1)} ${b.y.toFixed(1)}`;
const mapsUrl = 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(company.hq);
---
<section id="presence">
  <div class="wrap">
    <div class="section-head reveal">
      <div class="kicker">Presence</div>
      <h2>Headquartered in Mumbai. Working across borders.</h2>
      <p>Offices in Mumbai and Kolkata, with a presence in New York.</p>
    </div>

    <div class="map reveal"><div class="map-in">
      <svg viewBox={`0 0 ${W} 394`} role="img" aria-label="World map showing Zerix offices in Mumbai, Kolkata and New York">
        <path class="land" d={worldDots} />
        <path id="arc1" class="arc" d={arc(mum, nyc, 120)} />
        <path id="arc2" class="arc a2" d={arc(mum, kol, 22)} />
        <circle r="3.6" class="trav"><animateMotion dur="5s" repeatCount="indefinite"><mpath href="#arc1" /></animateMotion></circle>
        <circle r="3" class="trav"><animateMotion dur="3s" repeatCount="indefinite"><mpath href="#arc2" /></animateMotion></circle>
      </svg>
      {pins.map((p) => (
        <div class={`pin${p.hq ? ' hq' : ''}${p.name === 'Mumbai' ? ' lbl-bl' : ''}`} style={`left:${(p.x / 10).toFixed(2)}%;top:${((p.y / 394.4) * 100).toFixed(2)}%`}>
          <i></i><i></i><b></b>
          <span class="pl">{p.name}<small>{p.tag}</small></span>
        </div>
      ))}
    </div></div>

    <div class="contact-grid">
      <a class="cc reveal" href={`mailto:${company.email}`}>
        <span class="ci"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg></span>
        <small>Email</small><strong>{company.email}</strong>
      </a>
      <a class="cc reveal" style="--d:.08s" href={`tel:${company.phoneHref}`}>
        <span class="ci"><svg viewBox="0 0 24 24"><path d="M5 4h4l2 5-2.500 1.500a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/></svg></span>
        <small>Phone</small><strong>{company.phone}</strong>
      </a>
      <a class="cc reveal" style="--d:.16s" href={mapsUrl} target="_blank" rel="noopener">
        <span class="ci"><svg viewBox="0 0 24 24"><path d="M12 21s7-6.100 7-11a7 7 0 0 0-14 0c0 4.900 7 11 7 11z"/><circle cx="12" cy="10" r="2.500"/></svg></span>
        <small>Headquarters</small><strong>{company.hq}</strong>
      </a>
    </div>
  </div>
</section>
