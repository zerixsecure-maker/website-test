---
const sectors = [
  { n: 'Financial Services', d: 'Banks, brokers and financial institutions operate under strict cybersecurity mandates. We help you meet them and stay audit-ready.', tags: ['Regulatory compliance', 'Audit readiness', 'Access & fraud risk'],
    i: '<rect class="bar" x="4" y="11" width="3.6" height="9" rx="1"/><rect class="bar b2" x="10.2" y="5" width="3.6" height="15" rx="1"/><rect class="bar b3" x="16.4" y="8" width="3.6" height="12" rx="1"/>' },
  { n: 'Insurance', d: 'Policyholder data and claims systems demand strong privacy controls and the resilience to withstand incidents.', tags: ['Data privacy', 'Third-party risk', 'Incident readiness'],
    i: '<path d="M3 12a9 9 0 0 1 18 0z"/><path d="M12 12v6a2 2 0 0 1-4 0"/><path class="drop" d="M16 15v2M19 14v2M13 14v2"/>' },
  { n: 'Manufacturing', d: 'Connected plants and production lines turn a cyber incident into downtime. We secure the floor as well as the office.', tags: ['OT security', 'Network segmentation', 'Ransomware readiness'],
    i: '<g class="gear"><circle cx="12" cy="12" r="3"/><circle cx="12" cy="12" r="6.5"/><path d="M12 2.5v3M12 18.5v3M2.5 12h3M18.5 12h3M5.3 5.3l2.1 2.1M16.6 16.6l2.1 2.1M18.7 5.3l-2.1 2.1M7.4 16.6l-2.1 2.1"/></g>' },
  { n: 'Pharmaceutical', d: 'Research data, formulations and validated systems all need protection, and proof that their integrity holds.', tags: ['IP protection', 'Data integrity', 'Supply-chain risk'],
    i: '<g class="pill"><rect x="2" y="8.5" width="20" height="7" rx="3.5"/><path d="M12 8.5v7"/></g>' },
  { n: 'Data Centres', d: 'Availability and trust are the product. We harden the stack and test the controls that keep it standing.', tags: ['Infrastructure hardening', 'Access control', 'Resilience testing'],
    i: '<rect x="3" y="4" width="18" height="6" rx="1.5"/><rect x="3" y="14" width="18" height="6" rx="1.5"/><path d="M12 7h6M12 17h6"/><circle class="led" cx="7" cy="7" r="1"/><circle class="led l2" cx="7" cy="17" r="1"/>' },
  { n: 'IT & Technology', d: 'From secure development to protecting client data and earning the certifications customers ask for.', tags: ['Secure SDLC', 'VAPT', 'Certifications'],
    i: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M7 10l3 2.5L7 15"/><path class="cur" d="M13 16h4"/>' },
  { n: 'Chemical', d: 'Process control systems sit where safety and security meet, and where the stakes are highest.', tags: ['OT / ICS security', 'Safety-critical systems', 'Risk assessment'],
    i: '<path d="M9 3h6M10 3v6l-5 9a2 2 0 0 0 1.7 3h10.6a2 2 0 0 0 1.7-3l-5-9V3"/><circle class="bub" cx="11" cy="17" r="1"/><circle class="bub b2" cx="14" cy="16" r=".9"/>' },
  { n: 'And many more', d: 'Wherever sensitive data or critical operations exist, the same forensic-driven approach applies.', tags: ['Tailored scope', 'Any size', 'Any sector'],
    i: '<circle class="dt" cx="5" cy="12" r="1.7"/><circle class="dt d2" cx="12" cy="12" r="1.7"/><circle class="dt d3" cx="19" cy="12" r="1.7"/>' },
];
---
<section id="sectors" class="sectors-sec">
  <div class="wrap">
    <div class="section-head reveal">
      <div class="kicker">Sectors</div>
      <h2>Sector-aware security for the industries that run the economy.</h2>
      <p>Every industry has its own risks, regulators and realities. Explore how we approach each one.</p>
    </div>

    <div class="orbit-grid reveal">
      <div class="orbit" id="orbit" style="--ba:0deg" role="tablist" aria-label="Sectors">
        <i class="o-ring r1"></i><i class="o-ring r2"></i><i class="o-ring r3"></i>
        <div class="o-beam"></div>
        <div class="o-hub"><img src="/logo.png" alt="" width="596" height="419" decoding="async" /></div>
        {sectors.map((s, i) => (
          <button type="button" role="tab" class={`onode anim${i === 0 ? ' on' : ''}`} data-i={i} style={`--a:${i * 45}deg`} aria-label={s.n}>
            <svg viewBox="0 0 24 24" aria-hidden="true" set:html={s.i}></svg>
            <span class="ol">{s.n}</span>
          </button>
        ))}
      </div>

      <div class="spanel-wrap">
        {sectors.map((s, i) => (
          <div class={`spanel${i === 0 ? ' on' : ''}`} data-i={i}>
            <div class="sp-ic anim"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={s.i}></svg></div>
            <span class="sp-no">{String(i + 1).padStart(2, '0')} / 08</span>
            <h3>{s.n}</h3>
            <p>{s.d}</p>
            <ul>{s.tags.map((t) => <li>{t}</li>)}</ul>
          </div>
        ))}
        <div class="sp-bar"><i></i></div>
      </div>
    </div>
  </div>

  <script>
    const orbit = document.getElementById('orbit');
    if (orbit) {
      const nodes = [...orbit.querySelectorAll<HTMLElement>('.onode')];
      const panels = [...document.querySelectorAll<HTMLElement>('.spanel')];
      const bar = document.querySelector<HTMLElement>('.sp-bar i');
      const host = document.querySelector<HTMLElement>('.orbit-grid')!;
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      let cur = 0, ang = 0, timer = 0, hover = false, visible = false;
      // Random order without repeats: shuffle every sector, play them all, then reshuffle (never the same one twice in a row).
      let bag: number[] = [];
      const nextRandom = () => {
        if (!bag.length) {
          bag = nodes.map((_, k) => k).filter((k) => k !== cur);
          for (let k = bag.length - 1; k > 0; k--) { const j = Math.floor(Math.random() * (k + 1)); [bag[k], bag[j]] = [bag[j], bag[k]]; }
        }
        return bag.pop() as number;
      };
      const show = (i: number) => {
        const delta = ((i * 45 - ang) % 360 + 540) % 360 - 180;
        ang += delta; cur = i;
        orbit.style.setProperty('--ba', ang + 'deg');
        nodes.forEach((n, k) => n.classList.toggle('on', k === i));
        panels.forEach((p, k) => p.classList.toggle('on', k === i));
        if (bar) { bar.style.animation = 'none'; void bar.offsetWidth; bar.style.animation = ''; }
      };
      const loop = () => { clearTimeout(timer); if (reduce || !visible) return; timer = window.setTimeout(() => { if (!hover) show(nextRandom()); loop(); }, 8000); };
      nodes.forEach((n, i) => { n.addEventListener('click', () => { show(i); bag = bag.filter((k) => k !== i); loop(); }); n.addEventListener('mouseenter', () => { hover = true; show(i); }); n.addEventListener('mouseleave', () => { hover = false; loop(); }); });
      new IntersectionObserver(([e]) => { visible = e.isIntersecting; loop(); }, { threshold: 0.3 }).observe(host);
    }
  </script>
</section>
