---
const phrase = ['THINK CYBER', 'THINK ZERIX'];
const items = Array.from({ length: 8 }, () => phrase).flat();
---
<section class="brandband" aria-label="Zerix Securities">
  <div class="bb-marq" aria-hidden="true">
    <div class="bb-track">{[...items, ...items].map((t) => <span>{t}<i></i></span>)}</div>
  </div>
  <div class="wrap bb">
    <h2 class="bb-name reveal"><span>ZERIX</span><span class="out">SECURITIES</span></h2>
    <div class="bb-side reveal" style="--d:.15s">
      <img src="/logo.png" alt="" />
      <p>Forensic-driven cybersecurity, compliance and assurance.</p>
      <small>Mumbai · Kolkata · New York</small>
    </div>
  </div>
</section>
