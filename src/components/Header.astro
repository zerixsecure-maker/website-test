---
import { navLinks } from '../data/site';
const { current = '' } = Astro.props;
const here = (href: string) => (current && href.replace(/\//g, '') === current ? 'page' : undefined);
---
<header class="site-header">
  <div class="wrap nav">
    <a href="/" class="brand" aria-label="Zerix Securities home">
      <img src="/logo.png" alt="" width="596" height="419" decoding="async" />
      <span class="word"><b>ZERIX</b><small>Securities</small></span>
    </a>
    <nav aria-label="Main">
      <ul class="desk-nav">
        {navLinks.map((l) => <li><a href={l.href} aria-current={here(l.href)}>{l.label}</a></li>)}
      </ul>
    </nav>
    <a href="/#presence" class="btn btn-primary">Contact us <span class="arr">→</span></a>
    <button class="menu-btn" aria-label="Open menu" aria-expanded="false" aria-controls="mnav"><i></i><i></i><i></i></button>
  </div>
  <nav class="mobile-nav" id="mnav" aria-label="Mobile">
    <ul>
      {navLinks.map((l) => <li><a href={l.href} aria-current={here(l.href)}>{l.label}</a></li>)}
      <li><a href="/#presence" class="btn btn-primary">Contact us <span class="arr">→</span></a></li>
    </ul>
  </nav>
</header>
