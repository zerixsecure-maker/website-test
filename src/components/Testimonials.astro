---
import { testimonials } from '../data/testimonials';
const ini = (n: string) => n.split(' ').map((w) => w[0]).join('').slice(0, 2).toUpperCase();
---
<section id="testimonials">
  <div class="wrap">
    <div class="section-head reveal">
      <div class="kicker">Testimonials</div>
      <h2>In our clients' words.</h2>
    </div>
    <div class="tgrid">
      {testimonials.map((t, i) => (
        <figure class={`tcard reveal${t.placeholder ? ' ph-card' : ''}`} style={`--d:${i * 0.1}s`}>
          {t.placeholder && <span class="ph-tag">Placeholder</span>}
          <svg class="qm" viewBox="0 0 48 36" aria-hidden="true"><path d="M0 36V20C0 8 6 2 18 0v7c-6 1.5-8.500 5-8.500 9H18v20zM27 36V20C27 8 33 2 45 0v7c-6 1.500-8.500 5-8.500 9H45v20z" /></svg>
          <blockquote>{t.quote}</blockquote>
          <figcaption>
            <span class="av">{t.photo ? <img src={t.photo} alt={t.name} /> : <b>{ini(t.name)}</b>}</span>
            <span><strong>{t.name}</strong><small>{t.role} · {t.company}</small></span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
